EXOSCALE_API_KEY=
EXOSCALE_API_SECRET=
# HF_TOKEN takes precedence; HUGGINGFACE_TOKEN remains supported.
HF_TOKEN=
HUGGINGFACE_TOKEN=
SERVER_ROLE=
AUTH_TOKENS={}

CPU_IDLE_TIMEOUT_MINUTES=15
DEPLOYMENT_CONFIG=conf/deployments.toml

# Limit concurrent automatic-response logistic worker calls; excess callers await capacity.
AUTOMATIC_MAX_CONCURRENCY=4

# Per-model DeBERTa batching for SAR and automatic-response detection.
DEBERTA_BATCH_SIZE=8
DEBERTA_BATCH_DELAY_MS=10
DEBERTA_QUEUE_SIZE=64
DEBERTA_QUEUE_TIMEOUT_SECONDS=30

# Zone-scoped Exoscale AI API key for managed inference (separate from IAM credentials).
EXOSCALE_INFERENCE_API_KEY=
