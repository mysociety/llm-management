EXOSCALE_API_KEY=
EXOSCALE_API_SECRET=
# Zone-scoped Exoscale AI API key for managed inference (separate from IAM credentials).
EXOSCALE_INFERENCE_API_KEY=

# HF_TOKEN takes precedence; HUGGINGFACE_TOKEN remains supported.
HF_TOKEN=
SERVER_ROLE=
AUTH_TOKENS={}
# Opt in only for local testing with an empty AUTH_TOKENS mapping.
ALLOW_UNAUTHENTICATED=false

# External API keys: set via environment variables.
OPENAI_API_KEY=
TAVILY_API_KEY=
